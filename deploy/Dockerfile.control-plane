# Production TLS gateway + private Next upstream; retains administrative tooling.
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY control-plane/package.json control-plane/package.json
RUN pnpm install --frozen-lockfile
COPY control-plane ./control-plane
COPY shared ./shared
RUN pnpm build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000
COPY --from=build --chown=node:node /app /app
COPY --chmod=755 deploy/control-plane-entrypoint.sh /usr/local/bin/bunker-control-plane
USER node
EXPOSE 8443 8444
ENTRYPOINT ["bunker-control-plane"]
CMD ["node", "--import", "./control-plane/node_modules/tsx/dist/loader.mjs", "control-plane/scripts/serve.ts"]
