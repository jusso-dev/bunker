DATABASE_URL=postgresql://localhost:5432/bunker
BUNKER_ORIGIN=http://localhost:3000
# Only for development on a trusted loopback interface; production requires the TLS gateway.
BUNKER_ALLOW_INSECURE_LOOPBACK=false

# Production: two HTTPS listeners, Next bound ONLY to the loopback upstream.
# BUNKER_ORIGIN=https://console.example.test:8443
# BUNKER_HOST_ORIGIN=https://hosts.example.test:8444
# BUNKER_PRIVATE_UPSTREAM=http://127.0.0.1:3000
# BUNKER_GATEWAY_BIND=127.0.0.1
# BUNKER_HTTPS_PORT=8443
# BUNKER_MTLS_PORT=8444
# All identity files: absolute paths, regular files, owner/root, mode 0600.
# Gateway reads TLS key/certificate, host CA certificate, gateway secret.
# Next reads signing CA key/certificate, gateway secret, provider configuration.
# BUNKER_TLS_KEY_FILE=/run/bunker/tls.key
# BUNKER_TLS_CERT_FILE=/run/bunker/tls-chain.pem
# BUNKER_CA_KEY_FILE=/run/bunker/host-ca.key
# BUNKER_CA_CERT_FILE=/run/bunker/host-ca.pem
# BUNKER_GATEWAY_SECRET_FILE=/run/bunker/gateway.secret
# BUNKER_IDENTITY_PROVIDERS_FILE=/run/bunker/providers.json

# Optional webhook opt-in: operator-owned protected JSON config (see WEBHOOKS.md).
# Set on API and separate notification worker; signing refs resolve only in the worker.
# BUNKER_WEBHOOK_CONFIG_FILE=/run/bunker/webhooks.json
